{
  "name": "kai-regai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev": "npm run dev --workspace=web",
    "lint": "npm run lint --workspace=web",
    "build": "npm run build --workspace=web && node -e \"require('fs').cpSync('apps/web/dist', 'dist', {recursive: true})\""
  }
}
